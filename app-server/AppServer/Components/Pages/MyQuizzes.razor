@page "/myquizzes"
@using AppServer.Models
@using AppServer.Utils
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpContextAccessor
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

<PageTitle>Mine Quizzer</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Mine Quizzer</h2>
                <a href="/quiz/create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Opret Ny Quiz
                </a>
            </div>

            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Indlæser...</span>
                    </div>
                    <p class="mt-3 text-muted">Henter dine quizzer...</p>
                </div>
            }
            else if (error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Fejl:</strong> @error
                    <button type="button" class="btn-close" @onclick="ClearError"></button>
                </div>
                <div class="text-center">
                    <button class="btn btn-outline-primary" @onclick="LoadQuizzes">
                        <i class="bi bi-arrow-clockwise"></i> Prøv igen
                    </button>
                </div>
            }
            else if (successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @successMessage
                    <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
                </div>
            }

            @if (!loading && error == null && !myQuizzes.Any())
            {
                <div class="card text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-inbox" style="font-size: 4rem; color: #6c757d;"></i>
                        <h4 class="mt-3">Du har ikke oprettet nogen quizzer endnu</h4>
                        <p class="text-muted mb-4">Kom i gang med at oprette din første quiz!</p>
                        <a href="/quiz/create" class="btn btn-primary btn-lg">
                            <i class="bi bi-plus-circle"></i> Opret Din Første Quiz
                        </a>
                    </div>
                </div>
            }

            @if (!loading && error == null && myQuizzes.Any())
            {
                <div class="mb-3 text-muted">
                    <i class="bi bi-info-circle"></i> Viser @myQuizzes.Count quiz@(myQuizzes.Count != 1 ? "zer" : "")
                </div>

                <div class="row g-3">
                    @foreach (var quiz in myQuizzes)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm hover-card">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title mb-3">
                                        <i class="bi bi-journal-text text-primary"></i>
                                        @quiz.Title
                                    </h5>
                                    
                                    <div class="mb-3">
                                        <span class="badge bg-primary me-2">
                                            <i class="bi bi-question-circle"></i>
                                            @quiz.QuestionCount spørgsmål
                                        </span>
                                        <span class="badge bg-success">
                                            <i class="bi bi-trophy"></i>
                                            @quiz.TotalPoints point
                                        </span>
                                    </div>
                                    
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-calendar3"></i>
                                        Oprettet: @quiz.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    
                                    <div class="mt-auto d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-primary flex-grow-1" 
                                                @onclick="() => ViewQuiz(quiz.QuizId)">
                                            <i class="bi bi-eye"></i> Se Quiz
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" 
                                                @onclick="() => ShowDeleteConfirmation(quiz)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@if (showDeleteDialog && deleteConfirmQuiz != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Bekræft Sletning
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Er du sikker på du vil slette denne quiz?</p>
                    <div class="alert alert-warning mb-0">
                        <strong>Quiz:</strong> @deleteConfirmQuiz.Title<br/>
                        <strong>Spørgsmål:</strong> @deleteConfirmQuiz.QuestionCount<br/>
                        <strong>Total Points:</strong> @deleteConfirmQuiz.TotalPoints
                    </div>
                    <p class="text-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-circle"></i>
                        <small>Denne handling kan ikke fortrydes.</small>
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" 
                            class="btn btn-secondary" 
                            @onclick="CancelDelete"
                            disabled="@deleting">
                        Annuller
                    </button>
                    <button type="button" 
                            class="btn btn-danger" 
                            @onclick="ConfirmDelete"
                            disabled="@deleting">
                        @if (deleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Sletter...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash-fill me-2"></i>
                            <span>Ja, Slet Quiz</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .modal.show {
        display: block;
    }
</style>

@code {
    private List<QuizSummaryDto> myQuizzes = new();
    private bool loading = true;
    private string? error;
    private string? successMessage;
    private bool showDeleteDialog = false;
    private QuizSummaryDto? deleteConfirmQuiz;
    private bool deleting = false;

    protected override async Task OnInitializedAsync()
    {
        var httpContext = HttpContextAccessor.HttpContext;
        var userIdString = httpContext?.Session.GetString(SessionKeys.UserId);
        
        if (string.IsNullOrEmpty(userIdString))
        {
            Nav.NavigateTo("/login", forceLoad: true);
            return;
        }

        await LoadQuizzes();
    }

    private async Task LoadQuizzes()
    {
        loading = true;
        error = null;
        StateHasChanged();
        
        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            httpClient.BaseAddress = new Uri(Nav.BaseUri);

            var response = await httpClient.GetAsync("/api/quizmanagement/myquizzes");

            if (response.IsSuccessStatusCode)
            {
                myQuizzes = await response.Content.ReadFromJsonAsync<List<QuizSummaryDto>>() ?? new();
                myQuizzes = myQuizzes.OrderByDescending(q => q.CreatedAt).ToList();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login", forceLoad: true);
                return;
            }
            else
            {
                error = "Kunne ikke indlæse dine quizzer. Prøv igen senere.";
            }
        }
        catch (HttpRequestException ex)
        {
            error = $"Netværksfejl: Kunne ikke oprette forbindelse til serveren.";
        }
        catch (Exception ex)
        {
            error = $"Der opstod en uventet fejl ved indlæsning af quizzer.";
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private void ViewQuiz(Guid quizId)
    {
        Nav.NavigateTo($"/quiz/{quizId}");
    }

    private void ShowDeleteConfirmation(QuizSummaryDto quiz)
    {
        deleteConfirmQuiz = quiz;
        showDeleteDialog = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteDialog = false;
        deleteConfirmQuiz = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (deleteConfirmQuiz == null)
            return;

        deleting = true;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            httpClient.BaseAddress = new Uri(Nav.BaseUri);

            var response = await httpClient.DeleteAsync($"/api/quizmanagement/{deleteConfirmQuiz.QuizId}");

            if (response.IsSuccessStatusCode)
            {
                successMessage = $"Quiz '{deleteConfirmQuiz.Title}' blev slettet succesfuldt.";
                showDeleteDialog = false;
                deleteConfirmQuiz = null;
                
                await LoadQuizzes();
                
                _ = Task.Delay(5000).ContinueWith(_ => 
                {
                    successMessage = null;
                    InvokeAsync(StateHasChanged);
                });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                error = "Du har ikke tilladelse til at slette denne quiz.";
                showDeleteDialog = false;
                deleteConfirmQuiz = null;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                error = "Quiz blev ikke fundet. Den kan være blevet slettet allerede.";
                showDeleteDialog = false;
                deleteConfirmQuiz = null;
                await LoadQuizzes();
            }
            else
            {
                error = "Kunne ikke slette quiz. Prøv igen senere.";
                showDeleteDialog = false;
                deleteConfirmQuiz = null;
            }
        }
        catch (Exception ex)
        {
            error = $"Der opstod en fejl ved sletning af quiz.";
            showDeleteDialog = false;
            deleteConfirmQuiz = null;
        }
        finally
        {
            deleting = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        error = null;
        StateHasChanged();
    }

    private void ClearSuccess()
    {
        successMessage = null;
        StateHasChanged();
    }
}
