@page "/myquizzes"
@using AppServer.Models
@using AppServer.Utils
@using AppServer.Services
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject SimpleAuthService AuthService
@inject IJSRuntime JSRuntime
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mine Quizzer</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Mine Quizzer</h2>
                <a href="/quiz/create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Opret Ny Quiz
                </a>
            </div>

            <!-- Loading State -->
            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Indlæser...</span>
                    </div>
                    <p class="mt-3 text-muted">Henter dine quizzer...</p>
                </div>
            }
            <!-- Error State -->
            @if (_error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Fejl:</strong> @_error
                    <button type="button" class="btn-close" @onclick="ClearError"></button>
                </div>
                <div class="text-center">
                    <button class="btn btn-outline-primary" @onclick="LoadQuizzes">
                        <i class="bi bi-arrow-clockwise"></i> Prøv igen
                    </button>
                </div>
            }
            <!-- Success Message -->
            @if (_successMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @_successMessage
                    <button type="button" class="btn-close" @onclick="ClearSuccess"></button>
                </div>
            }

            <!-- Empty State -->
            @if (!_loading && _error == null && !_myQuizzes.Any())
            {
                <div class="card text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-inbox" style="font-size: 4rem; color: #6c757d;"></i>
                        <h4 class="mt-3">Du har ikke oprettet nogen quizzer endnu</h4>
                        <p class="text-muted mb-4">Kom i gang med at oprette din første quiz!</p>
                        <a href="/quiz/create" class="btn btn-primary btn-lg">
                            <i class="bi bi-plus-circle"></i> Opret Din Første Quiz
                        </a>
                    </div>
                </div>
            }

            <!-- Quiz Grid -->
            @if (!_loading && _error == null && _myQuizzes.Any())
            {
                <div class="mb-3 text-muted">
                    <i class="bi bi-info-circle"></i> Viser @_myQuizzes.Count quiz@(_myQuizzes.Count != 1 ? "zer" : "")
                </div>

                <div class="row g-3">
                    @foreach (var quiz in _myQuizzes)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm hover-card">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title mb-3">
                                        <i class="bi bi-journal-text text-primary"></i>
                                        @quiz.Title
                                    </h5>
                                    
                                    <div class="mb-3">
                                        <span class="badge bg-primary me-2">
                                            <i class="bi bi-question-circle"></i>
                                            @quiz.QuestionCount spørgsmål
                                        </span>
                                        <span class="badge bg-success">
                                            <i class="bi bi-trophy"></i>
                                            @quiz.TotalPoints point
                                        </span>
                                    </div>
                                    
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-calendar3"></i>
                                        Oprettet: @quiz.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    
                                    <div class="mt-auto d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-success" 
                                                @onclick="() => EditQuiz(quiz.QuizId)">
                                            <i class="bi bi-pencil"></i> Rediger
                                        </button>
                                        <button class="btn btn-sm btn-outline-primary flex-grow-1" 
                                                @onclick="() => ViewQuiz(quiz.QuizId)">
                                            <i class="bi bi-play-circle"></i> Test Quiz
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" 
                                                @onclick="() => ShowDeleteConfirmation(quiz)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
@if (_showDeleteDialog && _deleteConfirmQuiz != null)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Bekræft Sletning
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Er du sikker på du vil slette denne quiz?</p>
                    <div class="alert alert-warning mb-0">
                        <strong>Quiz:</strong> @_deleteConfirmQuiz.Title<br/>
                        <strong>Spørgsmål:</strong> @_deleteConfirmQuiz.QuestionCount<br/>
                        <strong>Total Points:</strong> @_deleteConfirmQuiz.TotalPoints
                    </div>
                    <p class="text-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-circle"></i>
                        <small>Denne handling kan ikke fortrydes.</small>
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" 
                            class="btn btn-secondary" 
                            @onclick="CancelDelete"
                            disabled="@_deleting">
                        Annuller
                    </button>
                    <button type="button" 
                            class="btn btn-danger" 
                            @onclick="ConfirmDelete"
                            disabled="@_deleting">
                        @if (_deleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Sletter...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash-fill me-2"></i>
                            <span>Ja, Slet Quiz</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .hover-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .modal.show {
        display: block;
    }
</style>

@code {
    private List<QuizSummaryDto> _myQuizzes = new();
    private bool _loading = true;
    private string? _error;
    private string? _successMessage;
    private bool _showDeleteDialog = false;
    private QuizSummaryDto? _deleteConfirmQuiz;
    private bool _deleting = false;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("=== MYQUIZZES: OnInitializedAsync START ===");
        
        // TRY LOCALSTORAGE FIRST (persistent across reloads), then fall back to AuthService
        string? userIdString = null;
        
        try
        {
            userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            Console.WriteLine($"🔍 MYQUIZZES: LocalStorage UserId={userIdString ?? "NULL"}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ MYQUIZZES: LocalStorage error: {ex.Message}");
        }
        
        if (string.IsNullOrEmpty(userIdString))
        {
            userIdString = AuthService.GetUserId();
            Console.WriteLine($"🔍 MYQUIZZES: AuthService UserId={userIdString ?? "NULL"}");
        }
        
        if (string.IsNullOrEmpty(userIdString))
        {
            Console.WriteLine("❌ MYQUIZZES: No userId - redirecting to login");
            Nav.NavigateTo("/login");
            return;
        }

        await LoadQuizzes();
    }

    private async Task LoadQuizzes()
    {
        _loading = true;
        _error = null;
        _successMessage = null; // Clear old success messages too
        StateHasChanged();
        
        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            httpClient.BaseAddress = new Uri(Nav.BaseUri);

            var response = await httpClient.GetAsync("/api/quizmanagement/myquizzes");

            if (response.IsSuccessStatusCode)
            {
                _myQuizzes = await response.Content.ReadFromJsonAsync<List<QuizSummaryDto>>() ?? new();
                
                // Sort by created date (newest first)
                _myQuizzes = _myQuizzes.OrderByDescending(q => q.CreatedAt).ToList();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Nav.NavigateTo("/login");
                return;
            }
            else
            {
                _error = "Kunne ikke indlæse dine quizzer. Prøv igen senere.";
            }
        }
        catch (HttpRequestException ex)
        {
            _error = $"Netværksfejl: Kunne ikke oprette forbindelse til serveren.";
        }
        catch (Exception ex)
        {
            _error = $"Der opstod en uventet fejl ved indlæsning af quizzer.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ViewQuiz(Guid quizId)
    {
        // TODO: Create quiz view/preview page
        Nav.NavigateTo($"/quiz/{quizId}/view");
    }
    
    private void EditQuiz(Guid quizId)
    {
        // TODO: Create quiz edit page
        Nav.NavigateTo($"/quiz/{quizId}/edit");
    }

    private void ShowDeleteConfirmation(QuizSummaryDto quiz)
    {
        _deleteConfirmQuiz = quiz;
        _showDeleteDialog = true;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _showDeleteDialog = false;
        _deleteConfirmQuiz = null;
        StateHasChanged();
    }

    private async Task ConfirmDelete()
    {
        if (_deleteConfirmQuiz == null)
            return;

        _deleting = true;
        StateHasChanged();

        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            httpClient.BaseAddress = new Uri(Nav.BaseUri);

            var response = await httpClient.DeleteAsync($"/api/quizmanagement/{_deleteConfirmQuiz.QuizId}");

            if (response.IsSuccessStatusCode)
            {
                _successMessage = $"Quiz '{_deleteConfirmQuiz.Title}' blev slettet succesfuldt.";
                _showDeleteDialog = false;
                _deleteConfirmQuiz = null;
                
                // Reload the quiz list
                await LoadQuizzes();
                
                // Auto-hide success message after 5 seconds
                _ = Task.Delay(5000).ContinueWith(_ => 
                {
                    _successMessage = null;
                    InvokeAsync(StateHasChanged);
                });
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _error = "Du har ikke tilladelse til at slette denne quiz.";
                _showDeleteDialog = false;
                _deleteConfirmQuiz = null;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _error = "Quiz blev ikke fundet. Den kan være blevet slettet allerede.";
                _showDeleteDialog = false;
                _deleteConfirmQuiz = null;
                await LoadQuizzes();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                _error = "Kunne ikke slette quiz. Prøv igen senere.";
                _showDeleteDialog = false;
                _deleteConfirmQuiz = null;
            }
        }
        catch (Exception ex)
        {
            _error = $"Der opstod en fejl ved sletning af quiz.";
            _showDeleteDialog = false;
            _deleteConfirmQuiz = null;
        }
        finally
        {
            _deleting = false;
            StateHasChanged();
        }
    }

    private void ClearError()
    {
        _error = null;
        StateHasChanged();
    }

    private void ClearSuccess()
    {
        _successMessage = null;
        StateHasChanged();
    }
}
