@page "/profile"
@using AppServer.Models
@using AppServer.Services
@inject NavigationManager Nav
@inject SimpleAuthService AuthService
@inject QuizGrpcClient QuizClient
@inject UserGrpcClient UserClient
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Min Profil</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Indlæser...</span>
                    </div>
                    <p class="mt-3 text-muted">Henter profil...</p>
                </div>
            }
            else if (_error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Fejl:</strong> @_error
                </div>
            }
            else if (_stats != null)
            {
                <!-- Header with User Info -->
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center"
                                     style="width: 80px; height: 80px;">
                                    <i class="bi bi-person-fill text-white" style="font-size: 2.5rem;"></i>
                                </div>
                            </div>
                            <div class="col">
                                <h2 class="mb-1">
                                    @if (_userProfile != null)
                                    {
                                        <text>@_userProfile.FirstName @_userProfile.LastName</text>
                                    }
                                    else
                                    {
                                        <text>Min Profil</text>
                                    }
                                </h2>
                                @if (_userProfile != null)
                                {
                                    <p class="text-muted mb-1">
                                        <i class="bi bi-envelope-fill me-1"></i>
                                        @_userProfile.Email
                                    </p>
                                    <p class="text-muted mb-1">
                                        <i class="bi bi-calendar-fill me-1"></i>
                                        Semester: <strong>@_userProfile.Semester</strong>
                                    </p>
                                }
                                <p class="text-muted mb-0">
                                    <i class="bi bi-trophy-fill text-warning"></i>
                                    Total Score: <strong class="text-primary fs-4">@_stats.TotalScore</strong> point
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="card h-100 border-primary">
                            <div class="card-body text-center">
                                <i class="bi bi-trophy text-primary" style="font-size: 2rem;"></i>
                                <h3 class="mt-2 mb-0">@_stats.TotalScore</h3>
                                <small class="text-muted">Total Score</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 border-success">
                            <div class="card-body text-center">
                                <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                                <h3 class="mt-2 mb-0">@_stats.QuizzesTaken</h3>
                                <small class="text-muted">Quizzer Gennemført</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 border-warning">
                            <div class="card-body text-center">
                                <i class="bi bi-pencil-square text-warning" style="font-size: 2rem;"></i>
                                <h3 class="mt-2 mb-0">@_stats.QuizzesCreated</h3>
                                <small class="text-muted">Quizzer Oprettet</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Attempts -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history text-primary me-2"></i>
                            Seneste Forsøg
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (_stats.RecentAttempts.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Quiz</th>
                                            <th class="text-center">Score</th>
                                            <th class="text-center">Resultat</th>
                                            <th class="text-center">Tid</th>
                                            <th class="text-center">Dato</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var attempt in _stats.RecentAttempts)
                                        {
                                            var resultClass = attempt.Percentage >= 80 ? "text-success" :
                                                             (attempt.Percentage >= 50 ? "text-warning" : "text-danger");

                                            <tr>
                                                <td>
                                                    @attempt.QuizTitle
                                                    @if (attempt.IsBestAttempt)
                                                    {
                                                        <span class="badge bg-success ms-2">
                                                            <i class="bi bi-star-fill"></i> Bedste
                                                        </span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <strong>@attempt.Score</strong> / @attempt.TotalPoints
                                                </td>
                                                <td class="text-center @resultClass">
                                                    <strong>@attempt.Percentage.ToString("F0")%</strong>
                                                </td>
                                                <td class="text-center">
                                                    <small>@attempt.FormattedDuration</small>
                                                </td>
                                                <td class="text-center">
                                                    <small>@attempt.CompletedAt.ToString("dd/MM HH:mm")</small>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                                <p class="text-muted mt-2">Du har ikke gennemført nogen quizzer endnu</p>
                                <a href="/myquizzes" class="btn btn-primary">
                                    <i class="bi bi-play-circle me-2"></i>
                                    Tag en quiz
                                </a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Change Password -->
                <div class="card">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-lock-fill text-primary me-2"></i>
                            Skift Adgangskode
                        </h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(_passwordMessage))
                        {
                            <div class="alert @(_passwordSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
                                @_passwordMessage
                                <button type="button" class="btn-close" @onclick="() => _passwordMessage = null"></button>
                            </div>
                        }
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Nuværende Adgangskode</label>
                                    <input type="password" class="form-control" @bind="_currentPassword" placeholder="Indtast nuværende adgangskode" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Ny Adgangskode</label>
                                    <input type="password" class="form-control" @bind="_newPassword" placeholder="Indtast ny adgangskode" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Bekræft Ny Adgangskode</label>
                                    <input type="password" class="form-control" @bind="_confirmPassword" placeholder="Bekræft ny adgangskode" />
                                </div>
                                <button class="btn btn-primary" @onclick="ChangePassword" disabled="@_changingPassword">
                                    @if (_changingPassword)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <text>Skifter...</text>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-2"></i>
                                        <text>Skift Adgangskode</text>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private UserStatsDto? _stats;
    private UserProfileDto? _userProfile;
    private bool _loading = true;
    private string? _error;

    // Password change fields
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _changingPassword = false;
    private string? _passwordMessage;
    private bool _passwordSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadStats();
    }

    private async Task LoadStats()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            // Get userId from LocalStorage first, then AuthService
            string? userIdString = null;

            try
            {
                userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
            }
            catch { }

            if (string.IsNullOrEmpty(userIdString))
            {
                userIdString = AuthService.GetUserId();
            }

            if (string.IsNullOrEmpty(userIdString))
            {
                Nav.NavigateTo("/login");
                return;
            }

            if (!Guid.TryParse(userIdString, out var userId))
            {
                Nav.NavigateTo("/login");
                return;
            }

            AuthService.SetUserId(userIdString);

            // Load both user profile and stats
            _userProfile = await UserClient.GetUserByIdAsync(userId);
            _stats = await QuizClient.GetUserStatsAsync(userId);

            if (_stats == null)
            {
                _error = "Kunne ikke hente profil data.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Der opstod en fejl: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePassword()
    {
        _passwordMessage = null;
        _passwordSuccess = false;

        // Validation
        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _passwordMessage = "Nuværende adgangskode er påkrævet.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_newPassword))
        {
            _passwordMessage = "Ny adgangskode er påkrævet.";
            return;
        }

        if (_newPassword.Length < 8)
        {
            _passwordMessage = "Ny adgangskode skal være mindst 8 tegn.";
            return;
        }

        if (_newPassword != _confirmPassword)
        {
            _passwordMessage = "De nye adgangskoder matcher ikke.";
            return;
        }

        if (_userProfile == null)
        {
            _passwordMessage = "Kunne ikke hente bruger information.";
            return;
        }

        _changingPassword = true;
        StateHasChanged();

        try
        {
            var request = new UpdatePasswordRequest
            {
                Email = _userProfile.Email,
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword,
                ConfirmNewPassword = _confirmPassword
            };

            var baseUrl = Nav.BaseUri.TrimEnd('/');
            var response = await HttpClient.PutAsJsonAsync($"{baseUrl}/api/profile/password", request);

            if (response.IsSuccessStatusCode)
            {
                _passwordSuccess = true;
                _passwordMessage = "Adgangskode blev ændret succesfuldt!";

                // Clear fields
                _currentPassword = "";
                _newPassword = "";
                _confirmPassword = "";
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                if (errorContent.Contains("WRONG_PASSWORD"))
                {
                    _passwordMessage = "Nuværende adgangskode er forkert.";
                }
                else
                {
                    _passwordMessage = "Kunne ikke ændre adgangskode. Prøv igen.";
                }
            }
        }
        catch (Exception ex)
        {
            _passwordMessage = $"Der opstod en fejl: {ex.Message}";
        }
        finally
        {
            _changingPassword = false;
            StateHasChanged();
        }
    }
}
