@page "/leaderboard"
@using AppServer.Services
@using AppServer.Models
@inject QuizGrpcClient QuizClient
@inject SimpleAuthService AuthService
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Leaderboard</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="bi bi-trophy-fill text-warning"></i> Leaderboard</h2>
                <a href="/" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Tilbage
                </a>
            </div>

            <!-- Loading State -->
            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Indlæser...</span>
                    </div>
                    <p class="mt-3 text-muted">Henter leaderboard...</p>
                </div>
            }
            else if (_error != null)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Fejl:</strong> @_error
                </div>
            }
            else if (_leaderboard != null && _leaderboard.Any())
            {
                <!-- Leaderboard Table -->
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-bar-chart-fill"></i> Top Spillere
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="text-center" style="width: 80px;">Plads</th>
                                        <th>Navn</th>
                                        <th class="text-center">Semester</th>
                                        <th class="text-center">Total Score</th>
                                        <th class="text-center">Quizzer Taget</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _leaderboard)
                                    {
                                        var isCurrentUser = _currentUserId != null && entry.UserId == _currentUserId;
                                        var rowClass = isCurrentUser ? "table-info" : "";
                                        var rankBadgeClass = entry.Rank switch
                                        {
                                            1 => "bg-warning text-dark",
                                            2 => "bg-secondary",
                                            3 => "bg-bronze",
                                            _ => "bg-light text-dark"
                                        };

                                        <tr class="@rowClass">
                                            <td class="text-center">
                                                @if (entry.Rank <= 3)
                                                {
                                                    <span class="badge @rankBadgeClass fs-5 px-3 py-2">
                                                        @if (entry.Rank == 1)
                                                        {
                                                            <i class="bi bi-trophy-fill"></i>
                                                        }
                                                        else if (entry.Rank == 2)
                                                        {
                                                            <i class="bi bi-award-fill"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-award"></i>
                                                        }
                                                        @entry.Rank
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge @rankBadgeClass px-3 py-2">@entry.Rank</span>
                                                }
                                            </td>
                                            <td>
                                                <strong>@entry.FullName</strong>
                                                @if (isCurrentUser)
                                                {
                                                    <span class="badge bg-success ms-2">
                                                        <i class="bi bi-person-fill"></i> Dig
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info">@entry.Semester. semester</span>
                                            </td>
                                            <td class="text-center">
                                                <strong class="text-primary fs-5">@entry.TotalScore</strong>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success">@entry.QuizzesTaken</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Current User Stats (if not in top list) -->
                @if (_currentUserEntry != null && !_leaderboard.Any(e => e.UserId == _currentUserId))
                {
                    <div class="card mt-4 border-info">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-person-circle"></i> Din Placering
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row text-center">
                                <div class="col-md-3">
                                    <h5 class="text-muted">Plads</h5>
                                    <h3 class="text-primary">@_currentUserEntry.Rank</h3>
                                </div>
                                <div class="col-md-3">
                                    <h5 class="text-muted">Total Score</h5>
                                    <h3 class="text-success">@_currentUserEntry.TotalScore</h3>
                                </div>
                                <div class="col-md-3">
                                    <h5 class="text-muted">Quizzer Taget</h5>
                                    <h3 class="text-info">@_currentUserEntry.QuizzesTaken</h3>
                                </div>
                                <div class="col-md-3">
                                    <h5 class="text-muted">Semester</h5>
                                    <h3 class="text-warning">@_currentUserEntry.Semester</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Ingen data tilgængelig endnu. Tag nogle quizzer for at komme på leaderboardet!
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bg-bronze {
        background-color: #CD7F32 !important;
        color: white !important;
    }
</style>

@code {
    private List<LeaderboardEntryDto>? _leaderboard;
    private LeaderboardEntryDto? _currentUserEntry;
    private Guid? _currentUserId;
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID
        string? userIdString = null;

        try
        {
            userIdString = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "userId");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ Leaderboard: LocalStorage error: {ex.Message}");
        }

        if (string.IsNullOrEmpty(userIdString))
        {
            userIdString = AuthService.GetUserId();
        }

        if (!string.IsNullOrEmpty(userIdString) && Guid.TryParse(userIdString, out var userId))
        {
            _currentUserId = userId;
        }

        await LoadLeaderboard();
    }

    private async Task LoadLeaderboard()
    {
        _loading = true;
        _error = null;
        StateHasChanged();

        try
        {
            _leaderboard = await QuizClient.GetLeaderboardAsync(50);

            // Find current user in full leaderboard (might be outside top 50)
            if (_currentUserId.HasValue && _leaderboard != null)
            {
                _currentUserEntry = _leaderboard.FirstOrDefault(e => e.UserId == _currentUserId.Value);
            }
        }
        catch (Exception ex)
        {
            _error = $"Der opstod en fejl: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }
}
